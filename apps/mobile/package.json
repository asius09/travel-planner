{
  "name": "@travel-planner/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:mobile": "vitest run --reporter=verbose --config vitest.config.mobile.ts",
    "test:e2e": "maestro test .maestro/",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@neondatabase/auth": "0.7.0-beta",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.17",
    "@tanstack/react-query": "^5.45.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-font": "~12.0.0",
    "expo-image": "~1.13.0",
    "expo-linking": "~6.3.0",
    "expo-location": "~17.0.0",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "expo-symbols": "~0.2.0",
    "nativewind": "^4.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.13",
    "styled-components": "^6.6.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "@types/styled-components": "^5.1.36",
    "@types/styled-components-react-native": "^5.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}