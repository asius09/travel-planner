{
  "name": "@travel-planner/api",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --reporter=verbose --config vitest.config.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.2.0",
    "@neondatabase/auth": "0.7.0-beta",
    "better-auth": "^1.0.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.30.0",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.4.0",
    "jose": "^6.2.13",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsx": "^4.11.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}