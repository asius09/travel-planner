# Database
DATABASE_URL="postgresql://user:password@host:5432/travel_planner?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# API
API_PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS="exp://localhost:8081,http://localhost:8081,http://localhost:3000,exp://192.168.1.x:8081"

# Mobile app
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_APP_SCHEME="travelplanner"